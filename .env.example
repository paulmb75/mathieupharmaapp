# Copier ce fichier en `.env` puis adapter. Aucun secret réel ne doit être commité.

# Environnement applicatif : development | demo | production
# En production, le mode démo et le script de données fictives sont refusés.
APP_ENV=development

# URL publique de l'application (détermine notamment le flag Secure des cookies)
APP_URL=http://localhost:3000

# Base PostgreSQL (format : postgres://utilisateur:motdepasse@hote:port/base)
DATABASE_URL=postgres://mathieu:changer-moi@localhost:5432/mathieupharma

# Base utilisée par les tests d'intégration (sera vidée à chaque exécution)
TEST_DATABASE_URL=postgres://mathieu:changer-moi@localhost:5432/mathieupharma_test

# Répertoire privé des justificatifs (hors du dossier public, non servi statiquement)
STORAGE_DIR=./storage/documents

# Affiche le bandeau « Démonstration — données fictives » et les comptes de démo
# sur l'écran de connexion. Interdit lorsque APP_ENV=production.
DEMO_MODE=true

# Mot de passe des comptes de démonstration créés par `npm run db:seed`
# (12 caractères minimum, fictif, uniquement pour un poste local).
DEMO_PASSWORD=

# Désactive la télémétrie anonyme de Next.js
NEXT_TELEMETRY_DISABLED=1
